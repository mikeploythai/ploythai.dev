{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-16",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "ploythai-dev",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"secrets": {
		"required": ["GITHUB_PAT"]
	}
}
