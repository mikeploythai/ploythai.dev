---
import "@/styles.css";

import { ArrowUpRightIcon, GitForkIcon, StarIcon } from "@lucide/astro";

import Empty from "@/components/empty.astro";
import { experiences } from "@/data/experience";
import { getProfile, getRepos } from "@/data/github";

import { Image } from "astro:assets";

export const prerender = false;

Astro.cache.set({ maxAge: 3600, swr: 86400 });

const latestRepos = await getRepos({ per_page: 6 });

const {
	url: githubUrl,
	avatarUrl,
	contributionsCollection: { contributionCalendar },
} = await getProfile();
const contributionDays = contributionCalendar.weeks.flatMap(
	(week) => week.contributionDays,
);
const firstWeekday = contributionDays.at(0)?.weekday ?? 0;
const lastWeekday = contributionDays.at(-1)?.weekday ?? 6;
const contributionWeekCount = Math.ceil(
	(firstWeekday + contributionDays.length) / 7,
);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
	weekday: "short",
	month: "short",
	day: "numeric",
	timeZone: "UTC",
});

const latestExperiences = experiences
	.toSorted((a, b) => b.startDate.getTime() - a.startDate.getTime())
	.slice(0, 3);

const experienceDateFormatter = new Intl.DateTimeFormat("en-US", {
	month: "short",
	year: "numeric",
});
---

<html lang="en-US">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Mike Ploythai</title>
	</head>

	<body>
		<div id="root">
			<main>
				<header>
					<Image
						id="avatar"
						src={avatarUrl}
						alt=""
						width={45}
						height={45}
						loading="eager"
					/>

					<hgroup>
						<h1>Mike Ploythai</h1>

						<p id="role">
							Engineering @&nbsp;
							<a
								href={latestExperiences[0].url ?? "#"}
								target="_blank"
								rel="noreferrer"
								title={`Visit ${latestExperiences[0].organization}'s website in a new tab`}
							>
								<span>{latestExperiences[0].organization}</span>
								<ArrowUpRightIcon class="external-arrow" aria-hidden="true" />
							</a>
						</p>
					</hgroup>
				</header>

				<section id="about">
					<h2 class="sr-only">About</h2>

					<p>
						I design interfaces, fight with APIs, build agentic stuff, and talk
						way too much about software and the web with my friends. I&apos;m
						also a cat dad, a musician, and an occasional lifter.
					</p>

					<figure id="contributions">
						<figcaption>
							<strong>{contributionCalendar.totalContributions}</strong>
							&nbsp;contributions this month on&nbsp;
							<a
								href={githubUrl}
								target="_blank"
								rel="noreferrer"
								title="Visit Mike's GitHub in a new tab"
							>
								<span>GitHub</span>
								<ArrowUpRightIcon class="external-arrow" aria-hidden="true" />
							</a>
						</figcaption>

						<ol
							data-first-weekday={firstWeekday}
							data-last-weekday={lastWeekday}
							style={{
								"--first-weekday": firstWeekday + 1,
								"--last-weekday": lastWeekday + 2,
								"--week-count": contributionWeekCount,
							}}
						>
							{
								contributionDays.map(
									({ date, weekday, contributionCount, contributionLevel }) => (
										<li
											data-level={contributionLevel}
											style={`--weekday: ${weekday + 1}`}
											title={`${dateFormatter.format(new Date(`${date}T00:00:00Z`))}: ${contributionCount} contributions`}
										>
											<span class="sr-only">
												{dateFormatter.format(new Date(`${date}T00:00:00Z`))}
												:&nbsp;
												{contributionCount}
												contributions
											</span>
										</li>
									),
								)
							}
						</ol>
					</figure>
				</section>

				<hr />

				<section>
					<h2>
						<span class="section-heading__motif" aria-hidden="true">./</span>
						braindump
					</h2>

					<Empty />
				</section>

				<section id="experience">
					<h2>
						<span class="section-heading__motif" aria-hidden="true">./</span>
						experience
					</h2>

					<ol>
						{
							latestExperiences.map(
								({ organization, url, startDate, endDate, title }) => (
									<li>
										<div class="experience-timeline__heading">
											<div>
												<h3>{title}</h3>

												<p class="experience-timeline__organization">
													{url ? (
														<a
															href={url}
															target="_blank"
															rel="noreferrer"
															title={`Visit ${organization}'s website in a new tab`}
														>
															{organization}
															<ArrowUpRightIcon
																class="external-arrow"
																aria-hidden="true"
															/>
														</a>
													) : (
														organization
													)}
												</p>
											</div>

											<p class="badge">
												<time datetime={startDate.toISOString()}>
													{experienceDateFormatter.format(startDate)}
												</time>
												<span> to </span>
												{endDate ? (
													<time datetime={endDate.toISOString()}>
														{experienceDateFormatter.format(endDate)}
													</time>
												) : (
													"Now"
												)}
											</p>
										</div>
									</li>
								),
							)
						}
					</ol>
				</section>

				<section id="latest-repos">
					<h2>
						<span class="section-heading__motif" aria-hidden="true">./</span>
						projects
					</h2>

					<ol id="repos">
						{
							latestRepos.map((repo) => (
								<li>
									<a
										href={repo.html_url}
										target="_blank"
										rel="noreferrer"
										title={`Visit the ${repo.full_name} repo in a new tab`}
									>
										<span class="repo-card__heading">
											<h3>
												{repo.name}
												{repo.fork && (
													<>
														&nbsp;
														<span class="badge">
															<GitForkIcon />
															Fork
														</span>
													</>
												)}
											</h3>

											<ArrowUpRightIcon
												class="repo-card__arrow"
												aria-hidden="true"
											/>
										</span>

										{repo.description && (
											<p class="repo-card__description">{repo.description}</p>
										)}

										<span class="repo-card__meta">
											<span>
												<StarIcon />
												<span class="sr-only">Stars:</span>
												{repo.stargazers_count}
											</span>

											<span>
												<GitForkIcon />
												<span class="sr-only">Forks:</span>
												{repo.forks_count}
											</span>
										</span>

										{repo.languages.length > 0 && (
											<span
												aria-label={`Languages: ${repo.languages.map(({ name, percentage }) => `${name} ${percentage.toFixed(1)}%`).join(", ")}`}
												class="repo-card__language-bar"
												role="img"
											>
												{repo.languages.map(({ name, color, size }) => (
													<span
														aria-hidden="true"
														style={`--language-color: ${color ?? "var(--primary)"}; --language-size: ${size}`}
														title={name}
													/>
												))}
											</span>
										)}
									</a>
								</li>
							))
						}
					</ol>
				</section>

				<section>
					<h2>
						<span class="section-heading__motif" aria-hidden="true">./</span>
						experiments
					</h2>

					<Empty />
				</section>
			</main>
		</div>
	</body>
</html>

<style>
	#root {
		padding: 2rem;

		@media (width >= 48rem) {
			padding: 4rem;
		}
	}

	main {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		color: var(--muted);
		inline-size: min(100%, 48rem);
		margin-inline: auto;
	}

	header {
		display: flex;
		gap: 0.875rem;
	}

	#avatar {
		border-radius: var(--radius-full);
		background-color: var(--primary);
		outline: 1px solid oklch(1 0 0 / 0.1);
		outline-offset: -1px;
	}

	h1,
	h2 {
		color: var(--foreground);
	}

	h1 {
		font-size: 1rem;
	}

	h2 {
		font-size: 1.25rem;
	}

	#role {
		color: var(--muted);
	}

	.section-heading__motif {
		color: var(--primary);
		font-weight: 800;
	}

	#about {
		gap: 2rem;

		& > p {
			max-inline-size: 60ch;
		}
	}

	#contributions {
		display: grid;
		gap: 0.5rem;

		& > figcaption > strong {
			font-variant-numeric: tabular-nums;
			color: var(--foreground);
		}

		& > ol {
			display: grid;
			gap: clamp(0.25rem, 1vw, 0.5rem);
			grid-template-columns: repeat(7, minmax(0, 1fr));
			padding-inline-start: 0;
			list-style: none;

			&::before,
			&::after {
				content: "";
				align-self: center;
				block-size: 2px;
				border-radius: var(--radius-full);
			}

			&::before {
				background: linear-gradient(
					to right,
					color-mix(in oklab, var(--primary), transparent 75%),
					transparent
				);
			}

			&::after {
				background: linear-gradient(
					to left,
					color-mix(in oklab, var(--primary), transparent 75%),
					transparent
				);
			}

			&:not([data-first-weekday="0"])::before {
				grid-column: 1 / var(--first-weekday);
				grid-row: 1;
			}

			&[data-first-weekday="0"]::before,
			&[data-last-weekday="6"]::after {
				display: none;
			}

			&:not([data-last-weekday="6"])::after {
				grid-column: var(--last-weekday) / -1;
				grid-row: var(--week-count);
			}
		}

		& li {
			display: block;
			block-size: clamp(0.75rem, 2vw, 1rem);
			width: 100%;
			border-width: 1px;
			border-style: solid;
			border-radius: var(--radius-sm);

			&:first-child {
				grid-column-start: var(--weekday);
			}

			&[data-level="FIRST_QUARTILE"] {
				--contribution-color: color-mix(
					in oklab,
					var(--contribution),
					transparent 75%
				);
				border-color: var(--contribution-color);
				background-color: var(--contribution-color);
			}

			&[data-level="SECOND_QUARTILE"] {
				--contribution-color: color-mix(
					in oklab,
					var(--contribution),
					transparent 50%
				);
				border-color: var(--contribution-color);
				background-color: var(--contribution-color);
			}

			&[data-level="THIRD_QUARTILE"] {
				--contribution-color: color-mix(
					in oklab,
					var(--contribution),
					transparent 25%
				);
				border-color: var(--contribution-color);
				background-color: var(--contribution-color);
			}

			&[data-level="FOURTH_QUARTILE"] {
				border-color: var(--contribution);
				background-color: var(--contribution);
			}
		}
	}

	section {
		display: grid;
		gap: 0.875rem;
	}

	#experience {
		container-type: inline-size;
	}

	#experience > ol {
		padding-inline-start: 0;
		list-style: none;

		& > li {
			position: relative;
			padding: 0.125rem 0 1.75rem 1.75rem;

			&:last-child {
				padding-block-end: 0;
			}

			&::before {
				position: absolute;
				inset-block-start: 0.4375rem;
				inset-inline-start: 0;
				inline-size: 0.625rem;
				block-size: 0.625rem;
				border: 2px solid var(--primary);
				border-radius: var(--radius-full);
				background-color: var(--background);
				box-shadow: 0 0 0 0.3125rem var(--background);
				content: "";
				z-index: 1;
			}

			&:first-child::before {
				background-color: var(--primary);
			}

			&:not(:last-child)::after {
				position: absolute;
				inset-block: 0.75rem -0.75rem;
				inset-inline-start: 0.28125rem;
				inline-size: 1px;
				background: linear-gradient(
					to bottom,
					color-mix(in oklab, var(--primary), transparent 75%),
					transparent
				);
				content: "";
			}
		}
	}

	.experience-timeline__heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.375rem 1rem;
		flex-direction: column;
		flex-wrap: wrap;

		@container (width >= 40rem) {
			align-items: baseline;
			flex-direction: row;
		}

		& > div > h3 {
			color: var(--foreground);
			font-size: 1rem;
			line-height: 1.25;
		}
	}

	.experience-timeline__organization {
		margin-block-start: 0.25rem;
	}

	#about > ul {
		display: flex;
		gap: 0.5rem;
		padding-inline-start: 0;
		list-style: none;
	}

	#latest-repos {
		container-type: inline-size;
	}

	#repos {
		--cols: 1;
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		gap: 0.75rem;

		@container (width >= 40rem) {
			--cols: 2;
		}
	}

	#latest-repos > ol {
		padding-inline-start: 0;
		list-style: none;

		& li {
			border-radius: var(--radius-lg);
			background-color: color-mix(in oklab, var(--accent), transparent 85%);
			box-shadow: 0 0 0 1px oklch(1 0 0 / 0.08);

			&:has(> a:focus-visible) {
				outline: 2px solid var(--primary);
				outline-offset: 2px;
			}

			& > a {
				display: flex;
				flex-direction: column;
				gap: 0.625rem;
				block-size: 100%;
				padding: 1rem;
				color: inherit;
				text-decoration: none;
				font-weight: 400;

				&:focus-visible {
					outline: none;
					box-shadow: none;
				}
			}

			@media (hover: hover) {
				&:has(> a:hover) {
					background-color: color-mix(in oklab, var(--accent), transparent 65%);
					box-shadow: 0 0 0 1px oklch(1 0 0 / 0.13);
				}
			}

			@media (hover: hover) and (prefers-reduced-motion: no-preference) {
				transition-property: background-color, box-shadow;
				transition-duration: 100ms;
				transition-timing-function: ease-out;
			}
		}
	}

	.repo-card__heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.repo-card__heading > h3 {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--foreground);
		font-size: 1rem;
		line-height: 1.25;
		text-wrap: balance;
	}

	.repo-card__meta svg {
		inline-size: 1rem;
		block-size: 1rem;
		stroke-width: 1.5;
	}

	.repo-card__heading > h3 > svg {
		flex: 0 0 auto;
		inline-size: 0.875rem;
		block-size: 0.875rem;
		color: var(--muted);
		stroke-width: 1.5;
	}

	.repo-card__description {
		overflow: hidden;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.repo-card__arrow {
		flex: 0 0 auto;
		inline-size: 1.125rem;
		block-size: 1.125rem;
		color: var(--primary);
	}

	#repos p {
		line-height: 1.5;
		text-wrap: pretty;
	}

	.repo-card__meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-block-start: auto;
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
	}

	.repo-card__meta > span {
		display: inline-flex;
		align-items: center;
		gap: 0.3125rem;
	}

	.repo-card__language-bar {
		display: flex;
		overflow: hidden;
		block-size: 0.375rem;
		border-radius: var(--radius-full);

		& > span {
			flex: var(--language-size);
			background-color: var(--language-color);
		}
	}
</style>
