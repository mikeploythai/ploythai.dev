---
import "@/styles.css";

import { ArrowUpRightIcon } from "@lucide/astro";

import Empty from "@/components/empty.astro";
import { getRepos } from "@/data/github";

import { Image } from "astro:assets";

const latestRepos = await getRepos({ per_page: 6 });
---

<html lang="en-US">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Mike Ploythai</title>
	</head>

	<body>
		<div id="root">
			<main>
				<header>
					<Image
						id="avatar"
						src="https://github.com/mikeploythai.png"
						alt=""
						width={45}
						height={45}
						loading="eager"
					/>

					<hgroup>
						<h1>Mike Ploythai</h1>

						<p id="role">
							Engineering @&nbsp;
							<a
								href="https://pacifichealthworks.com"
								target="_blank"
								rel="noreferrer"
								title="Visit Pacific HealthWork's website in a new tab"
							>
								Pacific HealthWorks
								<ArrowUpRightIcon class="external-arrow" aria-hidden="true" />
							</a>
						</p>
					</hgroup>
				</header>

				<section id="about">
					<h2 class="sr-only">About</h2>

					<p>
						I design interfaces, fight against APIs, build agentic stuff, and
						talk way too much about software with my friends. I&apos;m also a
						cat dad, a musician, and an occasional lifter.
					</p>

					<ul>
						<li>
							<a
								href="https://github.com/mikeploythai"
								target="_blank"
								rel="noreferrer"
								title="Visit Mike's GitHub in a new tab"
							>
								GitHub
								<ArrowUpRightIcon class="external-arrow" aria-hidden="true" />
							</a>
						</li>
					</ul>
				</section>

				<hr />

				<section>
					<h2>
						<span class="section-heading__motif" aria-hidden="true">//</span>
						&nbsp;Blog
					</h2>

					<Empty />
				</section>

				<section>
					<h2>
						<span class="section-heading__motif" aria-hidden="true">//</span>
						&nbsp;Work
					</h2>

					<Empty />
				</section>

				<section id="latest-repos">
					<h2>
						<span class="section-heading__motif" aria-hidden="true">//</span>
						&nbsp;Projects
					</h2>

					<ol id="repos">
						{
							latestRepos.map((repo) => (
								<li>
									<Image
										src={`https://opengraph.githubassets.com/1/${repo.full_name}`}
										alt={`Preview of ${repo.full_name}`}
										width="640"
										height="320"
										loading="eager"
									/>

									<a
										href={repo.html_url}
										target="_blank"
										rel="noreferrer"
										title={`Visit the ${repo.full_name} repo`}
									>
										<span>
											Visit repo
											<ArrowUpRightIcon
												class="external-arrow"
												aria-hidden="true"
											/>
										</span>
									</a>
								</li>
							))
						}
					</ol>
				</section>
			</main>
		</div>
	</body>
</html>

<style>
	#root {
		padding: 2rem;

		@media (width >= 48rem) {
			padding: 4rem;
		}
	}

	main {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		color: var(--muted);
		inline-size: min(100%, 48rem);
		margin-inline: auto;
	}

	header {
		display: flex;
		gap: 0.875rem;
	}

	#avatar {
		border-radius: var(--radius-full);
		background-color: var(--primary);
		outline: 1px solid oklch(1 0 0 / 0.1);
		outline-offset: -1px;
	}

	h1,
	h2 {
		color: var(--foreground);
	}

	h1 {
		font-size: 1rem;
	}

	h2 {
		font-size: 1.25rem;
	}

	#role {
		color: var(--muted);
	}

	.section-heading__motif {
		color: var(--primary);
		font-weight: 800;
	}

	#about {
		max-inline-size: 60ch;
		gap: 2rem;
	}

	section {
		display: grid;
		gap: 0.875rem;
	}

	#about > ul {
		display: flex;
		gap: 0.5rem;
		padding-inline-start: 0;
		list-style: none;
	}

	#latest-repos {
		container-type: inline-size;
	}

	#repos {
		--cols: 1;
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		gap: 0.5rem;

		@container (width >= 40rem) {
			--cols: 2;
		}
	}

	#latest-repos > ol {
		padding-inline-start: 0;
		list-style: none;

		& li {
			position: relative;
			overflow: clip;
			border-width: 1px;
			border-style: solid;
			border-radius: var(--radius-lg);
			background-color: color-mix(in oklab, var(--accent), transparent 85%);

			&:has(> a:focus-visible) {
				outline: 2px solid var(--primary);
				outline-offset: 2px;
			}

			& > img {
				aspect-ratio: 2 / 1;
				width: 100%;
				height: auto;
			}

			& > a {
				display: inline-flex;
				padding: 0.5rem 0.875rem;
				border-top-width: 1px;
				border-top-style: solid;
				width: 100%;

				&:focus-visible {
					outline: none;
					box-shadow: none;
				}

				&::after {
					content: "";
					position: absolute;
					inset: 0;
				}
			}

			@media (hover: hover) {
				& > a:hover {
					background-color: color-mix(in oklab, var(--accent), transparent 50%);
				}
			}
		}
	}
</style>
